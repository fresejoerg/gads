# --- LiteLLM Proxy ---
LITELLM_BASE_URL=http://localhost:4000/v1
# Despite the name: GADS's LiteLLM VIRTUAL key (`gads-backend`), not the proxy's master key.
LITELLM_MASTER_KEY=

# --- Database (PostgreSQL) ---
GADS_DATABASE_URL=postgresql://llmuser:llmpassword@localhost:5432/litellm

# --- UI & Backend ---
GADS_BACKEND_URL=http://localhost:8001
GADS_WS_URL=ws://localhost:8001/ws

# --- Provider Keys (Only needed if not handled by MyLocalStack) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Tracing (core/tracing.py -> MLflow OTLP) ---
# Must be the same experiment the LiteLLM proxy exports to (its OTEL_HEADERS),
# or model calls land in another experiment and the run tree has none under its stages.
GADS_OTEL_ENDPOINT=http://localhost:5000/v1/traces
GADS_MLFLOW_EXPERIMENT_ID=
