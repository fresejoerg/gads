<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GADS Research Synthesis</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Plotly.js -->
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f8fafc; color: #1e293b; padding-top: 40px; padding-bottom: 40px; }
        .report-header { background: #ffffff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
        .report-header h1 { margin-top: 0; border-bottom: 3px solid #3b82f6; display: inline-block; padding-bottom: 5px; color: #0f172a; }
        .report-body { background: #ffffff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
        .card { border: 1px solid #cbd5e1; border-radius: 12px; padding: 25px; margin: 30px 0; background: #ffffff; box-shadow: none; }
        .plot-container { min-height: 400px; width: 100%; }
        .insight-text { font-size: 1.05rem; color: #475569; margin-bottom: 20px; padding: 15px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #94a3b8; }
        .card-footer-custom { margin-top: 15px; font-size: 0.95rem; color: #1e293b; border-top: 1px solid #f1f5f9; padding-top: 10px; }
        .takeaways { background: #eff6ff; border-left: 4px solid #3b82f6; padding: 25px; margin: 30px 0; border-radius: 0 8px 8px 0; }
        .narrative { font-size: 1.15rem; color: #334155; margin-bottom: 40px; white-space: pre-wrap; }
        .metrics-panel { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 25px; margin-bottom: 30px; }
        .metrics-panel h2 { color: #166534; margin-top: 0; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .metric-card { background: #ffffff; border: 1px solid #d1fae5; border-radius: 10px; padding: 20px 15px; }
        .metric-value { font-size: 2rem; font-weight: 700; color: #15803d; font-variant-numeric: tabular-nums; }
        .metric-name { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #6b7280; margin-top: 4px; }

        /* ——— Recipe-driven pipeline sections ——— */
        .rail { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 30px; }
        .rail a { text-decoration: none; display: flex; align-items: center; gap: 8px;
                  border: 1px solid #e2e8f0; border-radius: 999px; padding: 6px 14px;
                  background: #ffffff; color: #334155; font-size: 0.85rem; }
        .rail a:hover { border-color: #94a3b8; }
        .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px; }
        .dot-completed { background: #22c55e; }
        .dot-failed    { background: #ef4444; }
        .dot-bypassed  { background: #f59e0b; }
        .dot-pending, .dot-not_executed { background: #cbd5e1; }
        .step { border-top: 1px solid #e2e8f0; padding-top: 28px; margin-top: 36px; }
        .step-num { display: inline-flex; align-items: center; justify-content: center;
                    width: 30px; height: 30px; border-radius: 50%; background: #eff6ff;
                    color: #1d4ed8; font-weight: 700; font-size: 0.9rem; margin-right: 12px; }
        .step h3 { display: inline; font-size: 1.35rem; color: #0f172a; }
        .step-summary { color: #64748b; margin: 10px 0 0 42px; font-size: 0.95rem; }
        .badge-soft { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
                      border-radius: 6px; padding: 3px 8px; margin-left: 8px;
                      background: #f1f5f9; color: #475569; vertical-align: middle; }
        .badge-failed { background: #fee2e2; color: #b91c1c; }
        .badge-skipped { background: #f1f5f9; color: #94a3b8; }
        .badge-fallback { background: #fef3c7; color: #92400e; }
        .step-body { margin-left: 42px; }
        .chip-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0; }
        .chip { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
                padding: 8px 14px; font-size: 0.9rem; }
        .chip b { font-variant-numeric: tabular-nums; color: #0f172a; }
        .chip span { color: #64748b; font-size: 0.78rem; text-transform: uppercase;
                     letter-spacing: 0.05em; display: block; }
        .insight-list { list-style: none; padding-left: 0; margin: 12px 0; }
        .insight-list li { border-left: 3px solid #cbd5e1; padding: 4px 0 4px 14px;
                           margin-bottom: 10px; color: #334155; }
        .step details { margin-top: 14px; }
        .step summary { cursor: pointer; color: #64748b; font-size: 0.88rem; }
        .step-quiet { border-top: 1px dashed #e2e8f0; padding-top: 16px; margin-top: 20px; }
        .step-quiet .step-summary { margin-left: 42px; }
        .gap-note { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412;
                    border-radius: 8px; padding: 14px 18px; margin: 14px 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                <div class="report-header">
                    <h1>Research Synthesis Report</h1>
                    <p class="text-muted">Project ID: {{ project_id }}</p>
                </div>

                <div class="report-body">
                    {% if key_metrics %}
                    <div class="metrics-panel">
                        <h2>Key Metrics</h2>
                        <div class="row g-3">
                            {% for name, value in key_metrics.items() %}
                            <div class="col-6 col-md-3">
                                <div class="metric-card text-center">
                                    <div class="metric-value">{{ value }}</div>
                                    <div class="metric-name">{{ name | replace("_", " ") }}</div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <h2>Executive Summary</h2>
                    <div class="narrative">{{ narrative }}</div>
                    
                    <div class="takeaways">
                        <h3>Key Takeaways</h3>
                        <ul>
                            {% for t in takeaways %}
                            <li>{{ t }}</li>
                            {% endfor %}
                        </ul>
                    </div>

                    <hr class="my-5" style="border-top: 2px solid #f1f5f9; opacity: 1;">
                    
                    {# Card markup is a macro so follow-up sections render identically to the
                       main run. `uid` must be unique per card across the whole page: the
                       renderer below maps every `data-<uid>` script onto `plot-<uid>`. #}
                    {% macro render_card(card, uid) %}
                    <div class="card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="m-0">{{ card.description }}</h3>
                            <button class="btn btn-sm btn-outline-secondary" onclick="toggleRaw('raw-{{ uid }}')">View JSON</button>
                        </div>

                        {% if card.ctx_text %}
                        <div class="insight-text">{{ card.ctx_text }}</div>
                        {% endif %}

                        {% if card.type == 'json_plot' %}
                        <!-- The data is embedded safely as application/json -->
                        <script type="application/json" id="data-{{ uid }}" class="plotly-data">
                            {{ card.json_data | safe }}
                        </script>
                        <div id="plot-{{ uid }}" class="plot-container"></div>
                        <pre id="raw-{{ uid }}" class="d-none mt-3 p-3 bg-light border rounded" style="max-height: 200px; overflow: auto; font-size: 0.8rem;">{{ card.json_data }}</pre>

                        {% elif card.type == 'legacy_html' %}
                        <!-- Legacy HTML support -->
                        <div class="plot-container" style="border: 1px dashed #e2e8f0; padding: 10px;">
                            {{ card.html_content | safe }}
                        </div>

                        {% elif card.type == 'static_plot' %}
                        <div class="text-center">
                            <img src="data:image/png;base64,{{ card.img_b64 }}" style="max-width: 100%; border-radius: 8px;" alt="{{ card.description }}">
                        </div>

                        {% elif card.type == 'handover_bundle' %}
                        <div style="padding: 20px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; text-align: center;">
                            <p style="color: #92400e; font-weight: bold;">⚠️ Heavy Computation Handover</p>
                            <p>This task was bypassed due to high estimated runtime. Download the bundle to run the code locally.</p>
                            <a href="{{ card.filename }}" class="btn btn-warning mt-2 text-white" style="background-color: #d97706; border-color: #d97706;">Download Project Bundle (.zip)</a>
                        </div>
                        {% endif %}

                        <div class="card-footer-custom">
                            <strong>{{ card.caption }}</strong>
                        </div>
                    </div>
                    {% endmacro %}

                    {# ——— PIPELINE SECTIONS ———
                       Composed from the applied recipe's DAG, not from the artifact list:
                       one section per node, in execution order, including the reasoning and
                       audit nodes that draw nothing and the nodes that never ran. See
                       core/report_sections.py. #}
                    {% if sections %}
                    <h2>How This Result Was Produced</h2>
                    <p class="text-muted mb-4">
                        Each step below is a node of the applied recipe, in execution order,
                        with the evidence it produced.
                    </p>

                    <div class="rail">
                        {% for sec in sections %}
                        <a href="#step-{{ sec.index }}" title="{{ sec.status | replace('_', ' ') }}">
                            <span class="dot dot-{{ sec.status }}"></span>{{ sec.index }}. {{ sec.title }}
                        </a>
                        {% endfor %}
                    </div>

                    {% for sec in sections %}
                    {% set sec_i = loop.index %}{# outer index: `loop` is shadowed in the card loop #}
                    <div class="{{ 'step-quiet' if sec.collapsed else 'step' }}" id="step-{{ sec.index }}">
                        <div>
                            <span class="step-num">{{ sec.index }}</span>
                            <h3>{{ sec.title }}</h3>
                            {% if sec.status == 'not_executed' %}<span class="badge-soft badge-skipped">not executed</span>
                            {% elif sec.status == 'failed' %}<span class="badge-soft badge-failed">failed</span>
                            {% elif sec.status == 'bypassed' %}<span class="badge-soft">handed over</span>
                            {% elif sec.status == 'pending' %}<span class="badge-soft badge-skipped">never ran</span>
                            {% endif %}
                            {% if sec.fallback %}<span class="badge-soft badge-fallback">{{ sec.fallback }} fallback</span>{% endif %}
                        </div>
                        {% if sec.summary %}<div class="step-summary">{{ sec.summary }}</div>{% endif %}

                        <div class="step-body">
                            {% if sec.note %}
                            <div class="insight-text">{{ sec.note }}</div>
                            {% endif %}

                            {% if sec.status == 'not_executed' or sec.status == 'pending' %}
                            <div class="gap-note">
                                This step of the recipe did not run, so the analysis it was to
                                contribute is missing from this report.
                            </div>
                            {% elif sec.status == 'failed' %}
                            <div class="gap-note">
                                <strong>Step failed.</strong> {{ sec.error }}
                            </div>
                            {% endif %}

                            {% if sec.metrics %}
                            <div class="chip-row">
                                {% for name, value in sec.metrics.items() %}
                                <div class="chip"><b>{{ value }}</b><span>{{ name | replace("_", " ") }}</span></div>
                                {% endfor %}
                            </div>
                            {% endif %}

                            {% if sec.insights %}
                            <ul class="insight-list">
                                {% for ins in sec.insights %}
                                <li>{% if ins.artifact %}<strong>{{ ins.artifact }}:</strong> {% endif %}{{ ins.insight }}
                                    {% if ins.evidence %}<br><small class="text-muted">{{ ins.evidence }}</small>{% endif %}</li>
                                {% endfor %}
                            </ul>
                            {% endif %}

                            {% if sec.state %}
                            <p class="text-muted" style="font-size: 0.85rem;">
                                New in the kernel after this step:
                                {% for st in sec.state %}<code>{{ st.artifact }}</code>&nbsp;{{ st.insight.split('(')[-1].rstrip(')') }}{% if not loop.last %}, {% endif %}{% endfor %}
                            </p>
                            {% endif %}

                            {% for card in sec.cards %}
                            {{ render_card(card, 's' ~ sec_i ~ '-' ~ loop.index) }}
                            {% endfor %}

                            {% if sec.stdout %}
                            <details>
                                <summary>Step output{% if sec.model_used %} · {{ sec.model_used }}{% endif %}</summary>
                                <pre class="mt-2 p-3 bg-light border rounded" style="max-height: 260px; overflow: auto; font-size: 0.8rem;">{{ sec.stdout }}</pre>
                            </details>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}

                    {% if orphan_cards %}
                    <div class="step" id="step-extra">
                        <div><span class="step-num">+</span><h3>Additional Artifacts</h3></div>
                        <div class="step-summary">
                            Produced during the run but not attributable to a single recipe step.
                        </div>
                        <div class="step-body">
                            {% for card in orphan_cards %}
                            {{ render_card(card, 'x' ~ loop.index) }}
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    {% else %}
                    {# No pipeline structure recorded (legacy project): fall back to the flat
                       artifact list rather than showing nothing. #}
                    <h2>Supporting Data Visualizations</h2>
                    <p class="text-muted mb-4">The following artifacts provide quantitative grounding for the summary above.</p>
                    {% for card in cards %}
                    {{ render_card(card, 'm' ~ loop.index) }}
                    {% endfor %}
                    {% endif %}

                    {# ——— FOLLOW-UP SECTIONS ———
                       Analyst-directed work done after the autonomous run. Appended, never
                       merged into the section above: the original result must stay exactly
                       as the workflow produced it. #}
                    {% if followups %}
                    <hr class="my-5" style="border-top: 2px solid #f1f5f9; opacity: 1;">
                    <h2>Follow-up Analyses</h2>
                    <p class="text-muted mb-4">
                        Directed by the analyst after reviewing the results above.
                        These build on the same session state and do not change the original findings.
                    </p>
                    {% for fu in followups %}
                    {% set fu_i = loop.index %}{# outer index: `loop` is shadowed inside the card loop #}
                    <div style="border-left: 4px solid #6366f1; padding: 0.25rem 0 0.25rem 1rem; margin: 2rem 0 1rem;">
                        <div style="font-weight: 600; color: #1e293b;">{{ fu.instruction_text }}</div>
                        <div class="text-muted" style="font-size: 0.85rem;">
                            {{ fu.created_at }}{% if fu.model_used %} · {{ fu.model_used }}{% endif %}
                        </div>
                    </div>
                    {% if fu.narrative %}
                    <div class="insight-text">{{ fu.narrative }}</div>
                    {% endif %}
                    {% if fu.stdout %}
                    <pre class="mt-2 mb-3 p-3 bg-light border rounded" style="max-height: 260px; overflow: auto; font-size: 0.8rem;">{{ fu.stdout }}</pre>
                    {% endif %}
                    {% for card in fu.cards %}
                    {{ render_card(card, 'f' ~ fu_i ~ '-' ~ loop.index) }}
                    {% endfor %}
                    {% if not fu.cards and not fu.stdout %}
                    <p class="text-muted"><em>No new artifacts were produced by this follow-up.</em></p>
                    {% endif %}
                    {% endfor %}
                    {% endif %}

                </div>

                <div class="text-center mt-5 mb-4 text-muted" style="font-size: 0.85rem;">
                    Generated by GADS (Generative-augmented Data Science)
                </div>

            </div>
        </div>
    </div>

    <!-- Client-side rendering for JSON plots -->
    <script>
        function toggleRaw(id) {
            const el = document.getElementById(id);
            el.classList.toggle('d-none');
        }

        document.addEventListener("DOMContentLoaded", () => {
            console.log("Dashboard DOM loaded. Starting chart renders.");
            const plotElements = document.querySelectorAll('script[type="application/json"].plotly-data');
            
            Promise.allSettled(Array.from(plotElements).map(async (scriptTag) => {
                const targetDivId = scriptTag.id.replace('data-', 'plot-');
                const targetDiv = document.getElementById(targetDivId);
                
                try {
                    const rawJson = scriptTag.textContent.trim();
                    if (!rawJson) throw new Error("JSON payload is empty.");
                    
                    const figure = JSON.parse(rawJson);
                    
                    // Defensive check for Plotly binary bdata
                    if (figure.data && figure.data[0] && figure.data[0].z && figure.data[0].z.bdata) {
                        console.error("Binary bdata detected:", figure.data[0].z);
                        throw new Error("Plotly Binary Encoding detected (bdata). Browser cannot render this natively.");
                    }

                    // Render Plotly
                    await Plotly.newPlot(targetDivId, figure.data, figure.layout, {responsive: true});
                } catch (e) {
                    console.error("Render failed for " + targetDivId + ":", e);
                    if (targetDiv) {
                        targetDiv.innerHTML = 
                            '<div class="alert alert-warning m-3">' +
                                '<strong>Chart render failed</strong><br>' +
                                '<small>' + e.message + '</small>' +
                            '</div>';
                    }
                }
            }));
        });
    </script>
</body>
</html>